DATABASE_URL=postgresql://postgres:postgres@localhost:5433/job_hunt

# 独立集成测试库（名称必须以 _test 结尾；不设置则跳过集成测试）
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/job_hunt_test

PORT=3001
# 允许的前端源，逗号分隔；Vite 代理模式下不需要
CORS_ORIGINS=http://localhost:5173

# 验证码 HMAC 密钥；生产环境必须设置为随机长字符串
AUTH_CODE_SECRET=replace-with-a-long-random-secret
ADMIN_PHONE_NUMBERS=13800138000
