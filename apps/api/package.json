{
  "name": "@job-hunt/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/app.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "import": "tsx scripts/import-jobs.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.1",
    "@job-hunt/shared": "workspace:*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "hono": "^4.13.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "typescript": "7.0.2",
    "vitest": "^5.0.0"
  }
}
