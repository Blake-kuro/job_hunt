<view class="page home"><view class="hero"><view class="orb orb-one"></view><view class="orb orb-two"></view><view class="hero-top"><view class="brand-mark">职</view><view class="brand">职寻刷题<text> CAMPUS</text></view><view class="status-dot"></view></view><view class="hero-copy"><view class="eyebrow">DAILY PRACTICE</view><view class="hero-title">今天，也向目标<text>靠近一点。</text></view><view class="hero-sub">每天专注一道题，把准备变成确定感。</view></view></view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{dashboard}}" class="content"><view class="section-head"><text>学习概览</text><text class="date-label">本周</text></view><view class="stats"><view class="stat card"><view class="stat-icon fire">↗</view><view><text class="stat-value">{{dashboard.streakDays}}</text><text class="stat-unit">天</text><view class="stat-label">连续打卡</view></view></view><view class="stat card"><view class="stat-icon total">✓</view><view><text class="stat-value">{{dashboard.totalSolved}}</text><text class="stat-unit">题</text><view class="stat-label">累计完成</view></view></view></view><view class="week card"><view class="week-top"><view><view class="week-title">本周节奏</view><view class="week-caption">已完成 {{dashboard.weekSolved}} / {{dashboard.weekTarget}} 题</view></view><view class="week-score">{{dashboard.weekSolved}}</view></view><view class="progress"><view class="progress-fill" style="width: {{dashboard.weekSolved/dashboard.weekTarget*100}}%"></view></view><view class="days"><view wx:for="{{dashboard.week}}" wx:key="label" class="day {{item.done?'done':''}}"><view class="day-dot">{{item.done?'✓':''}}</view><text>{{item.label}}</text></view></view></view><button wx:if="{{dashboard.quota.tier==='GUEST'}}" class="btn btn-light login-btn" bindtap="login">手机号登录 · 开通专属题库</button><view class="section-head"><text>公司题库</text></view><view wx:if="{{loading}}" class="muted">加载中…</view><view wx:elif="{{banks && !banks.companies.length}}" class="muted">暂无可见题库，请联系管理员开通。</view><view wx:for="{{banks.companies}}" wx:for-item="company" wx:key="id" class="card"><view class="week-title">{{company.name}}</view><button wx:for="{{company.categories}}" wx:for-item="category" wx:key="id" class="btn btn-light start-btn" data-category-id="{{category.id}}" bindtap="start">{{category.name}} · 已答 {{category.answered}} / {{category.total}} →</button></view><view class="access"><view class="access-dot"></view><text>{{dashboard.quota.tier}} 档位 · 累计作答 {{dashboard.quota.used}} / {{dashboard.quota.limit===null?'不限':dashboard.quota.limit}} 题，非每日额度</text></view></view></view>
