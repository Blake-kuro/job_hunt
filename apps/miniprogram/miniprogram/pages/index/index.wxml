<view class="page">
  <view class="brand">
    <view class="brand-sq"></view>
    <text class="brand-name">职寻</text>
    <text class="brand-sub">CAMPUS</text>
    <text wx:if="{{dashboard}}" class="brand-right num">连续打卡 {{dashboard.streakDays}} 天</text>
  </view>

  <view class="head">
    <view class="kicker">题库</view>
    <view class="h1">选择公司与分类，按顺序刷题</view>
    <view class="muted">按公司分题库，一个分类一口气刷完；答错的自动进错题本。</view>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>

  <view wx:if="{{quotaExhausted}}" class="banner">
    <view class="banner-title">{{tier==='GUEST' ? '未登录只能作答 '+dashboard.quota.limit+' 道题' : '免费账号可作答 '+dashboard.quota.limit+' 道题'}}</view>
    <view class="banner-body">{{tier==='GUEST' ? '已用完，登录后可作答 '+freeQuestions+' 道。' : '已用完，升级 PRO 不限次数（公司注册中，请到网页版 /pro 查看开通方式）。'}}</view>
    <button wx:if="{{tier==='GUEST'}}" class="btn" bindtap="login">登录</button>
  </view>

  <view wx:if="{{dashboard}}" class="blueprint dash">
    <view class="corner tl"></view><view class="corner tr"></view><view class="corner bl"></view><view class="corner br"></view>
    <view class="blueprint-title">打卡仪表盘</view>
    <view class="stats">
      <view><view class="stat-n num">{{dashboard.streakDays}}</view><view class="stat-l">天连续</view></view>
      <view><view class="stat-n num">{{dashboard.weekSolved}}</view><view class="stat-l">本周作答</view></view>
      <view><view class="stat-n num">{{dashboard.totalSolved}}</view><view class="stat-l">累计作答</view></view>
    </view>
    <view class="week">
      <view wx:for="{{dashboard.week}}" wx:key="label" class="day">
        <view class="day-box {{item.done?'done':''}}"></view>
        <text class="day-label">{{item.label}}</text>
      </view>
    </view>
    <view class="hairline"></view>
    <view class="dash-foot num">
      <text>本周目标 {{dashboard.weekTarget}} 题</text>
      <text>{{dashboard.weekSolved >= dashboard.weekTarget ? '已达标' : '还差 ' + (dashboard.weekTarget - dashboard.weekSolved) + ' 题'}}</text>
    </view>
  </view>

  <view wx:if="{{dashboard}}" class="strip">
    <text class="badge">配额</text>
    <text class="strip-text num">累计作答 {{dashboard.quota.used}} / {{quotaLimit}} 题 · {{tierLabel}}</text>
    <text wx:if="{{tier==='GUEST'}}" class="strip-link" bindtap="login">登录 →</text>
  </view>

  <view wx:if="{{loading && !companies.length}}" class="muted loading">正在加载题库…</view>
  <view wx:elif="{{!loading && !companies.length && !error}}" class="empty">还没有题库</view>

  <view wx:for="{{companies}}" wx:for-item="company" wx:key="id" class="company">
    <view class="section-head">
      <text class="h2 company-name">{{company.name}}</text>
      <text class="section-count num">{{company.categories.length}} 个分类</text>
    </view>
    <view wx:for="{{company.categories}}" wx:for-item="category" wx:key="id" class="cat-row">
      <view class="cat-main">
        <view class="cat-name">{{category.name}}</view>
        <view class="cat-meta num">已答 {{category.answered}} / 共 {{category.total}} · 答对 {{category.correct}}</view>
        <view class="bar"><view class="bar-fill" style="width:{{category.pct}}%"></view></view>
      </view>
      <button class="btn btn-sm {{category.answered>0 && category.answered<category.total ? '' : 'btn-secondary'}}" disabled="{{category.disabled}}" data-category-id="{{category.id}}" bindtap="start">{{category.label}}</button>
    </view>
  </view>

  <view wx:if="{{dashboard}}" class="account">
    <block wx:if="{{tier==='GUEST'}}">
      <text class="muted">登录后作答记录会保存在同一个账号里</text>
      <button class="btn btn-secondary btn-sm" bindtap="login">登录</button>
    </block>
    <block wx:else>
      <text class="muted">{{tierLabel}}</text>
      <button class="btn btn-ghost btn-sm" bindtap="logout">退出登录</button>
    </block>
  </view>
</view>
