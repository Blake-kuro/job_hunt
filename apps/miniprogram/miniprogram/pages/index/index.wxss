.home{padding:0 0 calc(48rpx + env(safe-area-inset-bottom))}.hero{position:relative;height:530rpx;padding:34rpx 40rpx;box-sizing:border-box;overflow:hidden;border-radius:0 0 54rpx 54rpx;background:linear-gradient(145deg,#244d47 0%,#356e64 70%,#498377 100%);color:#fff}.orb{position:absolute;border:1rpx solid rgba(255,255,255,.13);border-radius:50%}.orb-one{width:400rpx;height:400rpx;right:-120rpx;top:-110rpx}.orb-two{width:250rpx;height:250rpx;right:-25rpx;top:-35rpx}.hero-top{position:relative;display:flex;align-items:center;z-index:1}.brand-mark{display:flex;width:48rpx;height:48rpx;margin-right:14rpx;align-items:center;justify-content:center;border-radius:14rpx;background:#dceae5;color:#28574f;font-size:25rpx;font-weight:800}.brand{font-size:27rpx;font-weight:700}.brand text{margin-left:6rpx;color:rgba(255,255,255,.55);font-size:16rpx;letter-spacing:3rpx}.status-dot{width:12rpx;height:12rpx;margin-left:auto;border:5rpx solid rgba(255,255,255,.15);border-radius:50%;background:#b9e6c8}.hero-copy{position:relative;margin-top:88rpx;z-index:1}.eyebrow{color:#a9d2c9;font-size:18rpx;letter-spacing:5rpx;font-weight:700}.hero-title{width:600rpx;margin-top:17rpx;font-size:55rpx;line-height:1.2;font-weight:750}.hero-title text{display:block;color:#d9eee7}.hero-sub{margin-top:23rpx;color:rgba(255,255,255,.66);font-size:24rpx}.content{padding:38rpx 32rpx 0}.section-head{display:flex;justify-content:space-between;margin:0 6rpx 20rpx;font-size:28rpx;font-weight:650}.date-label{color:#8a958f;font-size:22rpx;font-weight:400}.stats{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.stat{display:flex;align-items:center;gap:18rpx;padding:27rpx 24rpx}.stat-icon{display:flex;width:58rpx;height:58rpx;align-items:center;justify-content:center;border-radius:18rpx;font-weight:800}.fire{background:#fff0dc;color:#d47d35}.total{background:#e2eee9;color:#367065}.stat-value{font-size:43rpx;font-weight:750}.stat-unit{margin-left:4rpx;color:#829087;font-size:20rpx}.stat-label{margin-top:2rpx;color:#829087;font-size:20rpx}.week{margin-top:18rpx;padding:30rpx 28rpx}.week-top{display:flex;align-items:center;justify-content:space-between}.week-title{font-weight:700}.week-caption{margin-top:6rpx;color:#87918c;font-size:21rpx}.week-score{color:#376f65;font-size:42rpx;font-weight:750}.progress{height:10rpx;margin:25rpx 0 28rpx;overflow:hidden;border-radius:8rpx;background:#e8ece8}.progress-fill{height:100%;max-width:100%;border-radius:8rpx;background:linear-gradient(90deg,#4b8b7d,#82b09c)}.days{display:flex;justify-content:space-between}.day{display:flex;flex-direction:column;align-items:center;gap:10rpx;color:#9aa29e;font-size:19rpx}.day-dot{display:flex;width:39rpx;height:39rpx;align-items:center;justify-content:center;border-radius:50%;background:#edf0ed;color:#fff;font-size:18rpx}.day.done{color:#376f65}.day.done .day-dot{background:#4b8779}.login-btn{margin:27rpx 0 16rpx}.start-btn{display:flex;align-items:center;justify-content:center;margin-top:27rpx}.arrow{margin-left:18rpx;font-size:34rpx;font-weight:300}.access{display:flex;margin-top:19rpx;align-items:center;justify-content:center;color:#94a099;font-size:20rpx}.access-dot{width:9rpx;height:9rpx;margin-right:10rpx;border-radius:50%;background:#72a294}
