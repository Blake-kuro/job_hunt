<view class="page login">
  <view class="hero">
    <view class="ring ring-a"></view>
    <view class="ring ring-b"></view>
    <view class="brand light">
      <view class="brand-sq"></view>
      <text class="brand-name">职寻</text>
      <text class="brand-sub">CAMPUS</text>
    </view>
    <view class="kicker hero-kicker">你的校招工作台</view>
    <view class="hero-title">机会很多，进度不能乱。</view>
    <view class="hero-sub">收藏岗位、跟踪投递、坚持刷题。你的记录会安全地保存在同一个账号里。</view>
  </view>

  <view class="form">
    <view class="kicker accent">手机号登录</view>
    <view class="h1">欢迎回来</view>
    <view class="muted">未注册的手机号验证后将自动创建账号。</view>

    <view class="label">手机号</view>
    <view class="shell">
      <text class="prefix">+86</text>
      <input class="input" type="number" maxlength="11" disabled="{{sent}}" placeholder="请输入手机号" placeholder-class="ph" bindinput="onPhone" value="{{phone}}" />
      <text wx:if="{{sent}}" class="resend {{countdown>0||loading?'off':''}}" bindtap="sendCode">{{countdown>0 ? countdown+'s' : '重新获取'}}</text>
    </view>

    <block wx:if="{{sent}}">
      <view class="label">短信验证码</view>
      <view class="shell">
        <input class="input code" type="number" maxlength="6" placeholder="6 位验证码" placeholder-class="ph" bindinput="onCode" value="{{code}}" />
      </view>
      <view wx:if="{{developmentCode}}" class="muted dev">开发验证码已自动填入：{{developmentCode}}</view>
    </block>

    <view wx:if="{{error}}" class="error">{{error}}</view>

    <button class="btn submit" disabled="{{loading}}" loading="{{loading}}" bindtap="submit">{{sent ? '登录 / 注册' : '获取验证码'}}</button>
    <view class="agreement muted">继续即表示你同意平台服务条款与隐私政策</view>
  </view>
</view>
