.login { padding: 0 0 calc(64rpx + env(safe-area-inset-bottom)); }
.hero { position: relative; overflow: hidden; padding: 40rpx 40rpx 56rpx; background: var(--accent-900); color: #eef6ff; }
.ring { position: absolute; border: 1rpx solid rgba(116, 157, 196, 0.35); border-radius: 50%; }
.ring-a { width: 520rpx; height: 520rpx; right: -200rpx; top: -220rpx; }
.ring-b { width: 320rpx; height: 320rpx; right: -40rpx; top: -20rpx; border-color: rgba(148, 188, 227, 0.3); }
.brand.light .brand-name { color: #fff; }
.brand.light .brand-sub { color: var(--accent-400); }
.brand.light .brand-sq { background: var(--accent-400); }
.hero-kicker { position: relative; margin-top: 88rpx; color: var(--accent-400); }
.hero-title { position: relative; margin-top: 16rpx; color: #fff; font-size: 60rpx; font-weight: 700; line-height: 1.1; letter-spacing: -2rpx; }
.hero-sub { position: relative; margin-top: 24rpx; max-width: 560rpx; color: var(--accent-200); font-size: 26rpx; line-height: 1.7; }
.form { padding: 48rpx 40rpx 0; }
.form .h1 { margin-top: 12rpx; }
.form .muted { margin-top: 12rpx; }
.label { margin: 40rpx 0 12rpx; color: var(--n800); font-size: 22rpx; font-weight: 600; }
.shell { display: flex; align-items: center; min-height: 96rpx; border: 1rpx solid var(--divider); background: var(--surface); }
.prefix { padding: 0 24rpx; border-right: 1rpx solid var(--divider); color: var(--n700); font-size: 26rpx; line-height: 96rpx; }
.input { flex: 1; height: 96rpx; padding: 0 24rpx; font-size: 30rpx; }
.code { letter-spacing: 12rpx; }
.ph { color: var(--n500); }
.resend { padding: 0 24rpx; color: var(--accent-700); font-size: 24rpx; }
.resend.off { color: var(--n500); }
.form .dev { margin-top: 12rpx; font-size: 22rpx; }
.submit { margin-top: 40rpx; height: 96rpx; font-size: 30rpx; }
.form .agreement { margin-top: 24rpx; text-align: center; font-size: 22rpx; }
