<view class="page quiz-page">
  <view wx:if="{{loading}}" class="loading"><view class="loader"></view><text>正在准备题目</text></view>
  <view wx:elif="{{error && !today}}" class="empty-state"><view class="error">{{error}}</view><button class="btn" bindtap="next">重试</button><button class="btn btn-light back" bindtap="back">返回题库</button></view>
  <view wx:elif="{{!today.question}}" class="empty-state"><view class="empty-ring"><text>✓</text></view><view class="title">{{today.exhausted==='QUOTA'?'累计作答额度已用完':'该分类已全部答完'}}</view><view class="muted">{{today.exhausted==='QUOTA'?'请登录提升额度或联系管理员开通权限，额度不会每日重置。':'选择其他分类继续练习吧。'}}</view><button class="btn btn-light back" bindtap="back">返回题库</button></view>
  <block wx:else>
    <view class="quiz-top"><view class="counter">{{today.category.company}} · {{today.index}} / {{today.category.total}}</view><view class="close" bindtap="back">×</view></view>
    <view class="meta"><text class="tag">{{today.question.category}}</text><text class="difficulty">{{today.question.type==='MULTI'?'多选题':today.question.type==='JUDGE'?'判断题':'单选题'}} · {{today.question.difficulty}}</text></view>
    <view class="question-card card"><view class="question-no">{{today.question.section || 'QUESTION'}}</view><view class="question">{{today.question.prompt}}</view><view class="source">来源 · {{today.question.source}}</view></view>
    <view class="hint">{{today.question.type==='MULTI'?'选择所有正确答案（可多选）':'选择一个正确答案'}}</view>
    <view class="options"><view wx:for="{{options}}" wx:key="letter" class="option {{item.selected?'picked':''}} {{item.right?'right':''}} {{item.wrong?'wrong':''}}" data-letter="{{item.letter}}" bindtap="pick"><text class="letter">{{item.letter}}</text><text class="option-text">{{item.text}}</text><text class="check">{{item.right?'✓':item.selected?'●':''}}</text></view></view>
    <button wx:if="{{!result}}" class="btn submit-answer" disabled="{{!picked.length || submitting}}" loading="{{submitting}}" bindtap="submit">确认答案</button>
    <view wx:else class="result card"><view class="result-head"><view class="result-icon {{result.correct?'ok-bg':'bad-bg'}}">{{result.correct?'✓':'!'}}</view><view><view class="result-title {{result.correct?'ok':'bad'}}">{{result.correct?'回答正确':'回答错误 · 已加入错题本'}}</view><view class="answer">正确答案是 {{answerText}}</view></view></view><view class="divider"></view><view class="analysis-label">答案解析</view><view wx:for="{{result.explanation}}" wx:key="*this" class="explain"><text class="bullet">{{index+1}}</text><text>{{item}}</text></view><button class="btn next" bindtap="next">下一题 →</button></view>
    <view wx:if="{{error}}" class="error">{{error}}</view>
  </block>
</view>
