<view class="page quiz-page"><view wx:if="{{loading}}" class="loading"><view class="loader"></view><text>正在准备今天的题目</text></view><view wx:elif="{{!today.question}}" class="empty-state"><view class="empty-ring"><text>✓</text></view><view class="kicker">TODAY COMPLETE</view><view class="title">{{today.exhausted==='QUOTA'?'今天的额度完成啦':'题库暂时空空的'}}</view><view class="muted">{{today.exhausted==='QUOTA'?'保持这个节奏，明天继续。':'联系管理员开通你的专属题目。'}}</view><button class="btn btn-light back" bindtap="back">返回学习首页</button></view><block wx:else><view class="quiz-top"><view class="counter">{{today.indexLabel}}</view><view class="mini-progress"><view class="mini-fill"></view></view><view class="close" bindtap="back">×</view></view><view class="meta"><text class="tag">{{today.question.category}}</text><text class="difficulty">{{today.question.difficulty}}</text></view><view class="question-card card"><view class="question-no">QUESTION</view><view class="question">{{today.question.prompt}}</view><view class="source">来源 · {{today.question.source}}</view></view><view class="hint">选择你认为正确的答案</view><view class="options"><view wx:for="{{today.question.options}}" wx:key="letter" class="option {{picked===item.letter?'picked':''}} {{result&&item.letter===result.answer?'right':''}} {{result&&picked===item.letter&&picked!==result.answer?'wrong':''}}" data-letter="{{item.letter}}" bindtap="pick"><text class="letter">{{item.letter}}</text><text class="option-text">{{item.text}}</text><text class="check">{{result&&item.letter===result.answer?'✓':picked===item.letter?'●':''}}</text></view></view><button wx:if="{{!result}}" class="btn submit-answer" disabled="{{!picked||submitting}}" loading="{{submitting}}" bindtap="submit">确认答案</button><view wx:else class="result card"><view class="result-head"><view class="result-icon {{result.correct?'ok-bg':'bad-bg'}}">{{result.correct?'✓':'!'}}</view><view><view class="result-title {{result.correct?'ok':'bad'}}">{{result.correct?'回答正确':'再想一步'}}</view><view class="answer">正确答案是 {{result.answer}}</view></view></view><view class="divider"></view><view class="analysis-label">答案解析</view><view wx:for="{{result.explanation}}" wx:key="*this" class="explain"><text class="bullet">{{index+1}}</text><text>{{item}}</text></view><button class="btn next" bindtap="next">下一题 <text>→</text></button></view></block><view wx:if="{{error}}" class="error">{{error}}</view></view>
