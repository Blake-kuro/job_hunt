.crumb { display: flex; align-items: center; gap: 12rpx; color: var(--n700); font-size: 24rpx; }
.crumb-link { color: var(--accent-700); }
.crumb-sep { color: var(--n500); }
.meta { display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx; margin-top: 28rpx; }
.index { margin-right: 6rpx; color: var(--n800); font-size: 24rpx; font-weight: 600; }
.prompt { margin-top: 24rpx; font-size: 38rpx; font-weight: 600; line-height: 1.45; letter-spacing: -1rpx; }
.hint { margin-top: 16rpx; }
.options { display: flex; flex-direction: column; gap: 16rpx; margin-top: 32rpx; }
.option { display: flex; align-items: center; gap: 20rpx; min-height: 96rpx; padding: 20rpx 24rpx; box-sizing: border-box; border: 2rpx solid var(--divider); background: transparent; }
.letter { display: flex; width: 52rpx; height: 52rpx; flex-shrink: 0; align-items: center; justify-content: center; border: 1rpx solid var(--divider); color: var(--n700); font-size: 24rpx; font-weight: 700; }
.option-text { flex: 1; font-size: 28rpx; line-height: 1.5; }
.mark { flex-shrink: 0; color: var(--n700); font-size: 20rpx; }
.option.picked { border-color: var(--accent-700); background: var(--accent-100); }
.option.picked .letter { border-color: var(--accent); background: var(--accent); color: var(--bg); }
.option.right { border-color: var(--accent); background: var(--accent-100); }
.option.right .letter { border-color: var(--accent); background: var(--accent); color: var(--bg); }
.option.right .mark { color: var(--accent-700); }
.option.wrong { border-color: var(--n500); background: #f5f5f8; color: var(--n600); }
.option.wrong .letter { border-color: var(--n500); color: var(--n600); }
.actions { display: flex; align-items: center; gap: 24rpx; margin-top: 36rpx; }
.actions .btn { width: auto; flex-shrink: 0; }
.result { margin-top: 36rpx; }
.result-head { display: flex; flex-direction: column; gap: 8rpx; margin-top: 28rpx; }
.result-answer { font-size: 36rpx; font-weight: 700; }
.explain { margin-top: 28rpx; }
.explain-item { display: flex; gap: 14rpx; margin-top: 14rpx; color: var(--n800); font-size: 26rpx; line-height: 1.7; }
.bullet { display: flex; width: 36rpx; height: 36rpx; flex-shrink: 0; align-items: center; justify-content: center; margin-top: 4rpx; border: 1rpx solid var(--divider); color: var(--n700); font-size: 18rpx; }
.result .btn { margin-top: 32rpx; }
.source { display: block; margin-top: 40rpx; font-size: 22rpx; }
.state { padding-top: 8rpx; }
.state .h2 { margin-top: 12rpx; }
.state .muted { margin-top: 12rpx; }
.state .btn { margin-top: 28rpx; }
.state .crumb { margin-bottom: 40rpx; }
