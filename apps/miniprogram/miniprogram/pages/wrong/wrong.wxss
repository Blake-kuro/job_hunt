.head { margin-top: 40rpx; }
.head .muted { margin-top: 16rpx; }
.list { margin-top: 32rpx; }
.item { display: flex; align-items: center; gap: 24rpx; padding: 24rpx 0; border-bottom: 1rpx solid var(--hairline); }
.item-main { flex: 1; min-width: 0; }
.item-top { display: flex; align-items: center; gap: 14rpx; }
.item-no { color: var(--n700); font-size: 20rpx; font-weight: 700; letter-spacing: 2rpx; }
.item-title { margin-top: 12rpx; font-size: 28rpx; font-weight: 600; line-height: 1.5; }
.item .btn { flex-shrink: 0; margin: 0; }
