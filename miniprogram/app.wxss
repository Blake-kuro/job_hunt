page{background:#f5f6f1;color:#192521;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx}.page{min-height:100vh;padding:32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));box-sizing:border-box}.card{background:rgba(255,255,255,.94);border:1rpx solid rgba(36,76,70,.1);border-radius:28rpx;box-shadow:0 12rpx 40rpx rgba(30,55,48,.07)}.kicker{font-size:20rpx;letter-spacing:5rpx;color:#3c756a;font-weight:700}.title{margin:16rpx 0;font-size:54rpx;font-weight:750;line-height:1.18;letter-spacing:-2rpx}.muted{color:#748079;font-size:25rpx;line-height:1.75}.btn{height:96rpx;line-height:96rpx;border-radius:48rpx;background:linear-gradient(135deg,#376f65,#28574f);box-shadow:0 14rpx 30rpx rgba(40,87,79,.22);color:#fff;font-size:29rpx;font-weight:650;letter-spacing:1rpx}.btn::after{border:0}.btn[disabled]{background:#b9c4bf;box-shadow:none;color:#eef1ef}.btn-light{background:#e6efeb;box-shadow:none;color:#28574f}.error{margin:24rpx 0;padding:22rpx 24rpx;border-radius:16rpx;background:#fff0ed;color:#a13f36;font-size:24rpx}.empty{padding:120rpx 32rpx;text-align:center;color:#748079}.tag{display:inline-flex;padding:9rpx 17rpx;border-radius:20rpx;background:#e1eee9;color:#2f695e;font-size:20rpx;font-weight:650}
