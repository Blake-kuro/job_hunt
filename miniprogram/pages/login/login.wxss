.login{position:relative;padding:46rpx 34rpx;overflow:hidden}.decor{position:absolute;border-radius:50%;background:rgba(65,130,117,.08)}.decor-a{width:390rpx;height:390rpx;right:-210rpx;top:-130rpx}.decor-b{width:230rpx;height:230rpx;right:-60rpx;top:20rpx;border:1rpx solid rgba(55,111,101,.15);background:transparent}.top{position:relative;display:flex;align-items:center}.logo{display:flex;width:58rpx;height:58rpx;align-items:center;justify-content:center;border-radius:17rpx;background:#315f58;color:#fff;font-weight:800}.brand{margin-left:16rpx;font-size:29rpx;font-weight:750}.brand text{display:block;margin-top:1rpx;color:#87938d;font-size:13rpx;letter-spacing:3rpx}.intro{margin:110rpx 12rpx 48rpx}.title text{display:block;color:#397469}.form{position:relative;padding:34rpx 30rpx}.step{display:flex;height:40rpx;margin-bottom:38rpx;align-items:center;color:#8a948e;font-size:20rpx}.step-dot{display:flex;width:37rpx;height:37rpx;align-items:center;justify-content:center;border-radius:50%;background:#edf0ed;color:#9ca49f}.step-dot.active{background:#376f65;color:#fff}.step-line{width:42rpx;height:3rpx;background:#dde2de}.active-line{background:#77a79b}.step text{margin-left:14rpx}.label{margin:0 4rpx 12rpx;color:#506059;font-size:22rpx;font-weight:600}.input-shell{display:flex;height:94rpx;align-items:center;border:2rpx solid #dce1dc;border-radius:20rpx;background:#fafbf8}.input-shell:focus-within{border-color:#52877c;background:#fff}.phone>text{padding:0 22rpx;border-right:1rpx solid #d7dcd8;color:#5f6c66}.input-shell input{flex:1;padding:0 22rpx}.code-label{margin-top:26rpx}.code{letter-spacing:10rpx}.dev{display:flex;margin:14rpx 5rpx 0;align-items:center;color:#849088;font-size:20rpx}.dev-dot{width:10rpx;height:10rpx;margin-right:9rpx;border-radius:50%;background:#6a9b8f}.submit{margin-top:34rpx}.agreement{text-align:center;margin-top:22rpx;color:#a0a7a3;font-size:18rpx}
