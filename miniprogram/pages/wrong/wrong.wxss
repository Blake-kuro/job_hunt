.wrong-page{padding:0 28rpx 50rpx}.wrong-hero{margin:0 -28rpx 35rpx;padding:55rpx 40rpx 42rpx;border-radius:0 0 46rpx 46rpx;background:linear-gradient(145deg,#eef4f0,#e5eee9)}.hero-row{display:flex;align-items:center}.wrong-hero .title{margin-bottom:8rpx}.count{display:flex;width:110rpx;height:110rpx;margin-left:auto;flex-direction:column;align-items:center;justify-content:center;border-radius:32rpx;background:#315f58;color:#fff;box-shadow:0 12rpx 28rpx rgba(49,95,88,.2)}.count text{font-size:39rpx;font-weight:750}.count view{font-size:17rpx;color:#c6ddd5}.list{display:flex;flex-direction:column;gap:18rpx}.item{padding:26rpx 28rpx}.item-top{display:flex;align-items:center}.number{color:#9aaaa3;font-size:18rpx;font-weight:700;letter-spacing:2rpx}.due{display:flex;margin-left:auto;align-items:center;color:#5c776e;font-size:20rpx}.due-dot{width:9rpx;height:9rpx;margin-right:9rpx;border-radius:50%;background:#e39a53}.item-title{margin:23rpx 0 27rpx;font-size:29rpx;font-weight:650;line-height:1.55}.item-bottom{display:flex;padding-top:20rpx;align-items:center;border-top:1rpx solid #edf0ed;color:#9aa39e;font-size:19rpx}.master{margin:0 0 0 auto;padding:0 0 0 20rpx;background:transparent;color:#397469;font-size:22rpx;line-height:1.5}.master::after{border:0}.master text{display:inline-flex;margin-left:7rpx;width:30rpx;height:30rpx;align-items:center;justify-content:center;border-radius:50%;background:#e1eee9}.empty{margin-top:40rpx;padding:90rpx 30rpx}.empty-icon{display:flex;width:85rpx;height:85rpx;margin:0 auto 25rpx;align-items:center;justify-content:center;border-radius:50%;background:#e1eee9;color:#397469;font-size:40rpx}.empty-title{margin-bottom:8rpx;color:#39463f;font-size:29rpx;font-weight:650}
