{
  "name": "@job-hunt/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./client": "./src/client.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "gen:api": "pnpm dlx openapi-typescript@7 \"${OPENAPI_SOURCE:-../../apps/api/openapi.json}\" -o src/schema.d.ts",
